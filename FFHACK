goto MENU

:CON
set /p IP="IP do celular (mesma rede Wi-Fi): "
set /p PT="Porta (tela do celular): "
adb connect %IP%:%PT%
adb wait-for-device
goto RET

:ABRIR
adb shell monkey -p %PKG% -c android.intent.category.LAUNCHER 1 >nul
goto RET

:FECHAR
adb shell am force-stop %PKG%
goto RET

:CALIB
echo   (valores atuais)
echo   Tiro %FX%,%FY%  |  Pulo %JX%,%JY%  |  Correr %RX%,%RY%
set /p TF="Tiro X   [Enter mantem]: "
if not "%TF%"=="" set FX=%TF%
set /p TF="Tiro Y   [Enter mantem]: "
if not "%TF%"=="" set FY=%TF%
set /p TF="Pulo X   [Enter mantem]: "
if not "%TF%"=="" set JX=%TF%
set /p TF="Pulo Y   [Enter mantem]: "
if not "%TF%"=="" set JY=%TF%
set /p TF="Correr X [Enter mantem]: "
if not "%TF%"=="" set RX=%TF%
set /p TF="Correr Y [Enter mantem]: "
if not "%TF%"=="" set RY=%TF%
echo   Calibracao aplicada nesta sessao.
goto RET

:AIMX
set /a A1=%AY%-8 & set /a A2=%AY%+8
start "" adb shell input swipe %FX% %FY% %FX% %FY% 10500
for /l %%i in (1,1,10) do @(
 adb shell input swipe %CX% %A1% %CX% %A2% 60
 timeout /t 1 >nul
)
goto RET

:ATIRO
echo  Segurando o botao de tiro por 10s...
timeout /t 10 /nobreak >nul
goto RET

:ESP
adb shell wm density 120
goto RET

:WALL
adb shell wm density 120
adb shell settings put system screen_brightness 255
adb shell settings put secure screen_brightness 255
echo   WALL ligado: zoom + brilho maximo.
goto RET

:REST
adb shell wm density reset
adb shell settings put system screen_brightness 180
adb shell settings put secure screen_brightness 180
goto RET

:FPS
adb shell service call SurfaceFlinger 1008 i 120 >nul
goto RET

:RECO
for /l %%i in (1,1,25) do @(
 adb shell input swipe %CX% %CY% %CX% %CY5% 35
 adb shell input swipe %CX% %CY5% %CX% %CY% 35
)
goto RET

:VEL
for /l %%i in (1,1,8) do @(
 adb shell input swipe %RX% %RY% %RX% %RYM% 250
 timeout /t 1 >nul
 adb shell input tap %JX% %JY%
)
goto RET

:VOO
start "" adb shell input swipe %RX% %RY% %RX% %RYM% 12000
for /l %%i in (1,1,12) do @(
 adb shell input tap %JX% %JY%
 timeout /t 1 >nul
)
goto RET

:MOEDAS
adb shell su -c "id -u" 2>nul | findstr /b "0" >nul
if errorlevel 1 (
 echo   Sem root neste aparelho.
 goto RET
)
adb shell su -c "find /data/data/%PKG%/shared_prefs -name *.xml -exec sed -i s|<value>[0-9]*</value>|<value>999999</value>|g {} +"
echo   Prefs -^> 999999. Feche o jogo ([3]) e abra de novo.
goto RET

:FANT
adb shell settings get global adb_enabled 2>nul | findstr /b "0" >nul
if not errorlevel 1 (
 adb shell settings put global adb_enabled 1
 echo   Flag ADB REVISADA. Reconecte com [1].
 goto RET
)
adb shell settings put global adb_enabled 0
echo   Flag ADB OCULTA. Entre na partida AGORA.
goto RET

:UPD
curl -fsSL -o FFHACK.new %SERVIDOR%/FFHACK
if errorlevel 1 (
 echo   Falha no download.
 goto RET
)
move /y FFHACK.new FFHACK_novo.bat >nul
echo   Salvo como FFHACK_novo.bat - apos sair, troque o antigo por ele.
goto RET

:CONFIG
set /p BID="  Bin ID do jsonbin: "
set /p MK="  Master Key: "
set "FF_BID=%BID%"
set "FF_MK=%MK%"
set "FF_CFG=%CFG%"
set "FF_RES=%TEMP%\ff_res.txt"
powershell -NoProfile -EncodedCommand  >nul
set /p R=<"%TEMP%\ff_res.txt"
if "%R%"=="OK" echo   Painel configurado. Reinicie o FFHACK para aplicar.
if "%R%"=="ERRO" echo   Falhou - confira ID e Key.
goto RET

:USUARIOS
if not "%NIVEL%"=="admin" (
 echo   Area restrita ao roughen.
 goto RET
)
:USM
cls
echo   PAINEL DE USUARIOS - roughen
echo    [n] Ver   [v] Criar   [a] Apagar   [s] Trocar senha   [0] Voltar
set "s="
set /p "s=Escolha: "
if "%s%"=="n" goto ULIST
if "%s%"=="v" goto UNOVO
if "%s%"=="a" goto UDEL
if "%s%"=="s" goto UPASS
if "%s%"=="0" goto MENU
goto USM

:ULIST
set "FF_URL=%USERS_URL%"
set "FF_KEY=%API_KEY%"
powershell -NoProfile -EncodedCommand 
goto RET

:UNOVO
set /p _="  Novo usuario (sem espacos): "
> "%TEMP%\ff_nu.txt" echo !_!
set /p _="  Senha dele: "
> "%TEMP%\ff_ns.txt" echo !_!
call :HASH "%TEMP%\ff_ns.txt"
set "FF_HASH=%H%"
set "FF_URL=%USERS_URL%"
set "FF_KEY=%API_KEY%"
set "FF_CACHE=%CACHE%"
set "FF_RES=%TEMP%\ff_res.txt"
powershell -NoProfile -EncodedCommand  >nul
set /p R=<"%TEMP%\ff_res.txt"
if "%R%"=="CRIADO" echo   Criado - ele so precisa logar em qualquer terminal.
if "%R%"=="JAEXISTE" echo   Ja existe um usuario com esse nome.
if "%R%"=="ERRO_NET" echo   Servidor de usuarios fora - tente de novo.
goto RET

:UDEL
set /p AU="  Apagar usuario (roughen e protegido): "
if "%AU%"=="roughen" (
 echo   O admin nao sai do painel.
 goto RET
)
set "FF_URL=%USERS_URL%"
set "FF_KEY=%API_KEY%"
set "FF_AU=%AU%"
set "FF_RES=%TEMP%\ff_res.txt"
powershell -NoProfile -EncodedCommand  >nul
set /p R=<"%TEMP%\ff_res.txt"
if "%R%"=="REMOVIDO" echo   Removido.
if "%R%"=="ERRO_NET" echo   Servidor fora - tente de novo.
goto RET

:UPASS
set /p MP="  Trocar senha de (Enter = voce): "
if "%MP%"=="" set MP=%USER_ATUAL%
set /p _="  Nova senha: "
> "%TEMP%\ff_ns.txt" echo !_!
call :HASH "%TEMP%\ff_ns.txt"
set "FF_URL=%USERS_URL%"
set "FF_KEY=%API_KEY%"
set "FF_MP=%MP%"
set "FF_HASH=%H%"
set "FF_RES=%TEMP%\ff_res.txt"
powershell -NoProfile -EncodedCommand  >nul
set /p R=<"%TEMP%\ff_res.txt"
if "%R%"=="TROCADA" echo   Senha trocada.
if "%R%"=="ERRO_NET" echo   Servidor fora - tente de novo.
goto RET

:RET
echo.
pause
goto MENU