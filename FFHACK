: FFHACK v4.1  -  Painel de usuarios + Depuracao Wi-Fi
: Termux: bash FFHACK    CMD: copy FFHACK FFHACK.bat
: obs: no Termux sai uma linha goto erro no inicio - normal
: ==========================================================
goto :SECAO_CMD 2>nul
rm -f "./nul" 2>/dev/null

#!/usr/bin/env bash
# ====================== BASH / TERMUX ======================
ADB="adb"
PKG="com.dts.freefireth"
SERVIDOR="https://roughendev123.github.io/ffhack"
USERS_URL="https://api.jsonbin.io/v3/b/COLE_O_ID/latest"
API_KEY="COLE_A_MASTER_KEY"
Y_CAB=40; Y_PESC=46; Y_ACIMA=32
CFG="$HOME/ffhack/config"
LOCAL_DB="$HOME/ffhack/db.cache.json"
DB='{"usuarios":[]}'
W=0; H=0
USER_ATUAL=""; NIVEL=""

VERDE='\033[92m'; VERM='\033[91m'; AMAR='\033[93m'; CIANO='\033[96m'; NEGR='\033[1m'; FIM='\033[0m'
msg()  { printf "${AMAR}[%s] %s${FIM}\n" "$(date +%H:%M:%S)" "$*"; }
ok()   { printf "${VERDE}[OK] %s${FIM}\n" "$*"; }
erro() { printf "${VERM}[ERRO] %s${FIM}\n" "$*"; }
pausa(){ read -rp "  [Enter]..." _; }

[ -f "$CFG" ] && { USERS_URL=$(sed -n 1p "$CFG"); API_KEY=$(sed -n 2p "$CFG"); }
config_ok() { [[ "$USERS_URL" != *"COLE_O_ID"* ]]; }
hash_s()    { printf '%s' "$1" | sha256sum | cut -d' ' -f1; }

# ---------------- banco de usuarios ----------------
db_get() {
  DB=""
  if config_ok; then
    local R
    R=$(curl -fsSL -m 8 -H "X-Master-Key: $API_KEY" "$USERS_URL" 2>/dev/null)
    DB=$(jq -c '.record' <<<"$R" 2>/dev/null)
  fi
  if [ -n "$DB" ]; then
    mkdir -p ~/ffhack; echo "$DB" > "$LOCAL_DB"; return
  fi
  if [ -f "$LOCAL_DB" ]; then
    DB=$(cat "$LOCAL_DB"); msg "Sem servidor agora - usando cache local."
  else
    DB='{"usuarios":[]}'
  fi
}

db_put() {
  DB="$1"
  mkdir -p ~/ffhack; echo "$DB" > "$LOCAL_DB"
  if config_ok && curl -fsSL -m 8 -X PUT "${USERS_URL%/latest}" \
      -H "X-Master-Key: $API_KEY" -H "Content-Type: application/json" \
      --data-binary @"$LOCAL_DB" >/dev/null 2>&1; then
    ok "Salvo no servidor de usuarios."
  else
    msg "Servidor de usuarios fora - salvo so no cache deste terminal."
  fi
}

inicializar_painel() {
  db_get
  local N
  N=$(jq '.usuarios | length' <<<"$DB")
  if [ "$N" = "0" ]; then
    clear; msg "PRIMEIRO USO - criando o administrador 'roughen'"
    local S C H
    read -rsp "  Senha do roughen: " S; echo
    read -rsp "  Confirme:         " C; echo
    [ "$S" = "$C" ] || { erro "Senhas diferentes."; sleep 1; return; }
    H=$(hash_s "$S")
    db_put "{\"usuarios\":[{\"usuario\":\"roughen\",\"senha\":\"$H\",\"nivel\":\"admin\"}]}"
    ok "roughen criado (admin)."
    sleep 1
  fi
}

banner() {
  printf "${NEGR}${CIANO}"
  echo " ╔══════════════════════════════════════════╗"
  echo " ║  FFHACK v4.1 — Painel + Depuração Wi-Fi  ║"
  echo " ╚══════════════════════════════════════════╝"
  printf "${FIM}"
}

login() {
  local t=1 USR HS S HN
  while [ $t -le 3 ]; do
    clear; banner
    echo "  Painel de acesso"
    read -rp "  Usuário: " USR
    HS=$(jq -r --arg u "$USR" '.usuarios[] | select(.usuario==$u) | .senha' <<<"$DB")
    if [ -n "$HS" ]; then
      read -rsp "  Senha:   " S; echo
      HN=$(hash_s "$S")
      if [ "$HS" = "$HN" ]; then
        USER_ATUAL=$USR
        NIVEL=$(jq -r --arg u "$USR" '.usuarios[] | select(.usuario==$u) | .nivel' <<<"$DB")
        ok "Bem-vindo, $USR [$NIVEL]."
        sleep 1
        return
      fi
    fi
    erro "Usuário ou senha inválida (tentativa $t de 3)."
    t=$((t+1)); sleep 1
  done
  exit 1
}

# ---------------- area do roughen ----------------
eh_admin() { [ "$NIVEL" = "admin" ]; }

painel_usuario() {
  eh_admin || { erro "Área restrita ao roughen."; pausa; return; }
  while true; do
    clear
    echo "  PAINEL DE USUÁRIOS — roughen"
    echo "   [n] Ver usuários   [v] Criar"
    echo "   [a] Apagar         [s] Trocar senha"
    echo "   [0] Voltar"
    read -rp "  → " s
    case $s in
      n) jq -r '.usuarios[] | "  \(.usuario)   [\(.nivel)]"' <<<"$DB"; pausa ;;
      v) novo_usuario ;;
      a) apagar_usuario ;;
      s) trocar_senha ;;
      0) return ;;
    esac
  done
}

novo_usuario() {
  clear; msg "Criar usuário"
  local NU S H
  read -rp "  Nome (sem espaços): " NU
  [ ${#NU} -ge 3 ] || { erro "Nome curto demais."; return; }
  if jq -e --arg u "$NU" '.usuarios[] | select(.usuario==$u)' <<<"$DB" >/dev/null; then
    erro "Já existe esse nome."; return
  fi
  read -rsp "  Senha: " S; echo
  H=$(hash_s "$S")
  db_put "$(jq --arg u "$NU" --arg h "$H" '.usuarios += [{"usuario":$u,"senha":$h,"nivel":"user"}]' <<<"$DB")"
  ok "'$NU' criado - ele acessa o hack inteiro logando em qualquer terminal."
  pausa
}

apagar_usuario() {
  read -rp "  Apagar usuário (roughen é protegido): " AU
  [ "$AU" = "roughen" ] && { erro "O admin não sai do painel."; return; }
  db_put "$(jq --arg u "$AU" '.usuarios |= map(select(.usuario != $u))' <<<"$DB")"
  ok "'$AU' removido."
  pausa
}

trocar_senha() {
  read -rp "  Usuário (Enter = você): " MU; MU=${MU:-$USER_ATUAL}
  local S H
  read -rsp "  Nova senha: " S; echo
  H=$(hash_s "$S")
  if jq -e --arg u "$MU" '.usuarios[] | select(.usuario==$u)' <<<"$DB" >/dev/null; then
    db_put "$(jq --arg u "$MU" --arg h "$H" '(.usuarios[] | select(.usuario==$u)) |= (.senha=$h)' <<<"$DB")"
    ok "Senha de '$MU' trocada."
  else
    erro "Usuário não existe."
  fi
  pausa
}

configurar_painel() {
  clear; msg "Servidor de usuários (jsonbin.io)"
  local BID K U
  read -rp "  Bin ID:    " BID
  read -rp "  Master Key:" K
  U="https://api.jsonbin.io/v3/b/$BID/latest"
  if curl -fsSL -m 8 -H "X-Master-Key: $K" "$U" >/dev/null 2>&1; then
    mkdir -p ~/ffhack; printf '%s\n%s\n' "$U" "$K" > "$CFG"
    USERS_URL="$U"; API_KEY="$K"
    ok "Painel configurado e testado."
  else
    erro "Falhou o teste - confira ID/Key e se o bin existe."
  fi
  pausa
}

# ---------------- jogo ----------------
resolvido() { $ADB get-state 2>/dev/null | grep -qx device; }
exige()     { resolvido || { erro "Sem conexão - use [1] antes."; pausa; return 1; }; }

getres() {
  local R
  R=$($ADB shell wm size 2>/dev/null | tr -d '\r' | grep -oE '[0-9]+x[0-9]+' | head -1)
  [ -n "$R" ] || { erro "Sem resposta do celular."; return; }
  W=${R%x*}; H=${R#*x}
  ok "Resolução detectada: ${W}x${H}"
}

conectar() {
  clear
  msg "Celular: DESENVOLVEDOR → DEPURAÇÃO SEM FIO. Mesma rede Wi-Fi nos dois."
  read -rp "IP do celular:                        " IP
  read -rp "Porta de PAREAMENTO (Android 11+):    " PTP
  read -rp "Código de 6 dígitos (vazio p/ pular): " COD
  [ -n "$COD" ] && { echo "$COD" | $ADB pair "$IP:$PTP" 2>&1 | tr -d '\r'; }
  read -rp "Porta de CONEXÃO (tela principal):    " PTA
  $ADB connect "$IP:$PTA" 2>&1 | tr -d '\r'
  sleep 1
  if resolvido; then getres; calibrar; ok "Conectado: $IP:$PTA"
  else erro "Falhou. Confira IP/portas e aceite no celular."; fi
  pausa
}

calibrar() {
  FX=$(( W*86/100 )); FY=$(( H*85/100 ))
  JX=$(( W*88/100 )); JY=$(( H*73/100 ))
  RX=$(( W*12/100 )); RY=$(( H*88/100 ))
  CX=$(( W/2 ));      CY=$(( H*48/100 ))
  echo
  echo "  Pontos de toque atuais (X Y):"
  echo "   Tiro: $FX $FY  |  Pulo: $JX $JY  |  Correr: $RX $RY"
  read -rp "  Ajustar tiro?   (X Y, Enter mantém)   " T; set -- $T $FX $FY; FX=$1; FY=$2
  read -rp "  Ajustar pulo?   (X Y, Enter mantém)   " T; set -- $T $JX $JY; JX=$1; JY=$2
  read -rp "  Ajustar correr? (X Y, Enter mantém)   " T; set -- $T $RX $RY; RX=$1; RY=$2
  ok "Calibração salva."
  pausa
}

abrir()  { $ADB shell monkey -p "$PKG" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1; ok "Jogo abrindo..."; pausa; }
fechar() { $ADB shell am force-stop "$PKG" >/dev/null 2>&1; ok "Jogo fechado."; pausa; }

mira_aimbot() { # $1 = altura em %  $2 = nome
  exige || return
  local P=$1 NOM=$2 D AY i=0
  read -rp "Duração (s) [10]: " D; D=${D:-10}
  AY=$(( H*P/100 ))
  $ADB shell input swipe $FX $FY $FX $FY $((D*1000+500)) &
  msg "$NOM: ${D}s - mantenha o alvo no centro da tela."
  while [ $i -lt $((D/2)) ]; do
    $ADB shell input swipe $CX $((AY-8)) $CX $((AY+8)) 60 >/dev/null 2>&1 &
    $ADB shell input swipe $CX $((AY+8)) $CX $((AY-8)) 60 >/dev/null 2>&1 &
    sleep 1; i=$((i+1))
  done
  wait
  ok "Finalizado."
}
tiro_cabeca() { mira_aimbot $Y_CAB   "Tiro na cabeça"; }
tiro_pescoco(){ mira_aimbot $Y_PESC  "Tiro no pescoço"; }
tiro_acima()  { mira_aimbot $Y_ACIMA "Acima da cabeça"; }

autotiro() {
  exige || return
  read -rp "Duração (s) [10]: " D; D=${D:-10}
  msg "Segurando o botão de tiro por ${D}s..."
  $ADB shell input swipe $FX $FY $FX $FY $((D*1000))
  ok "Autotiro pronto."
  pausa
}

esp() { exige && { $ADB shell wm density 120 >/dev/null && ok "ESP ligado (zoom de densidade)."; pausa; }; }

wall() {
  exige || return
  $ADB shell wm density 120 >/dev/null
  $ADB shell settings put system screen_brightness 255 2>/dev/null
  $ADB shell settings put secure screen_brightness 255 2>/dev/null
  ok "WALL ligado: zoom + brilho máximo."
  msg "Ver pessoa por cima de parede solida de verdade e coisa de overlay (injeção) - este modo puxa tudo que a tela ainda deixa ver."
  pausa
}

restaurar_visao() {
  exige && {
    $ADB shell wm density reset >/dev/null
    $ADB shell settings put system screen_brightness 180 2>/dev/null
    $ADB shell settings put secure screen_brightness 180 2>/dev/null
    ok "Visão restaurada."; pausa; }
}

fps120() {
  exige || return
  $ADB shell service call SurfaceFlinger 1008 i 120 >/dev/null 2>&1
  ok "Teto de frames liberado (se o painel for 120Hz+)."
  pausa
}

antireco() {
  exige || return
  read -rp "Duração (s) [10]: " D; D=${D:-10}
  local i=0
  msg "Antireco ${D}s."
  while [ $i -lt $((D*5)) ]; do
    $ADB shell input swipe $CX $CY $CX $((CY-5)) 35 >/dev/null
    $ADB shell input swipe $CX $((CY-5)) $CX $CY 35 >/dev/null
    i=$((i+1))
  done
  ok "Antireco finalizado."
  pausa
}

velocidade() {
  exige || return
  local i=0
  msg "Velocidade: correr + pulo por 8s."
  while [ $i -lt 8 ]; do
    $ADB shell input swipe $RX $RY $RX $((RY-140)) 250 >/dev/null
    sleep 0.2
    $ADB shell input tap $JX $JY >/dev/null
    sleep 0.3
    i=$((i+1))
  done
  ok "Feito."
  pausa
}

voo() {
  exige || return
  local i=0
  $ADB shell input swipe $RX $RY $RX $((RY-140)) 12000 &
  msg "Voo: corrida contínua + pulos por 12s."
  while [ $i -lt 12 ]; do
    $ADB shell input tap $JX $JY >/dev/null
    sleep 0.4
    i=$((i+1))
  done
  wait
  ok "Feito."
  pausa
}

moedas() {
  exige || return
  if $ADB shell su -c "id -u" 2>/dev/null | tr -d '\r' | grep -qx 0; then
    $ADB shell su -c "find /data/data/$PKG/shared_prefs -name '*.xml' -exec sed -i 's|<value>[0-9]*</value>|<value>999999</value>|g' {} +"
    ok "Vals das prefs → 999999. Feche ([3]) e reabra o jogo."
  else
    erro "Aparelho sem root - moedas/skins não rodam."
  fi
  pausa
}

fantasma() {
  exige || return
  local FLAG
  FLAG=$($ADB shell settings get global adb_enabled 2>/dev/null | tr -d '\r')
  if [ "$FLAG" = "0" ]; then
    $ADB shell settings put global adb_enabled 1
    ok "Flag ADB revisada. Reconecte com [1]."
  else
    $ADB shell settings put global adb_enabled 0
    ok "Flag ADB ocultada. ENTRE NA PARTIDA AGORA."
  fi
  pausa
}

update() {
  msg "Baixando atualização de: $SERVIDOR/FFHACK"
  if curl -fsSL "$SERVIDOR/FFHACK" -o "$HOME/ffhack/FFHACK.new" 2>/dev/null || \
     wget -qO "$HOME/ffhack/FFHACK.new" "$SERVIDOR/FFHACK"; then
    sed -i 's/\r$//' "$HOME/ffhack/FFHACK.new"
    mv -f "$HOME/ffhack/FFHACK.new" "$HOME/ffhack/FFHACK"
    ok "Atualizado. Saia ([0]) e rode de novo."
  else
    erro "Falha no download."
  fi
  pausa
}

inicializar_painel
login

# ============================ MENU ============================
while true; do
  clear
  banner
  echo "  Logado: ${USER_ATUAL:-?} [${NIVEL:-?}]"
  echo "  [1]  Conectar           [2]  Abrir jogo       [3]  Fechar jogo"
  echo "  [4]  Calibrar botões"
  echo "  [5]  Tiro na cabeça     [6]  Tiro no pescoço"
  echo "  [7]  Acima da cabeça    [8]  Autotiro"
  echo "  [9]  ESP (zoom)         [10] WALL             [11] Restaurar visão"
  echo "  [12] FPS 120"
  echo "  [13] Antireco           [14] Velocidade       [15] Voo"
  echo "  [16] Moedas/Skins (root)  [17] Fantasma"
  echo "  [18] Atualizar código   [19] Configurar painel"
  echo "  [20] Usuários (roughen)"
  echo "  [0]  Sair"
  read -rp "  → " op
  case $op in
    1) conectar ;;         2) abrir ;;            3) fechar ;;
    4) calibrar ;;         5) tiro_cabeca ;;      6) tiro_pescoco ;;
    7) tiro_acima ;;       8) autotiro ;;
    9) esp ;;              10) wall ;;            11) restaurar_visao ;;
    12) fps120 ;;
    13) antireco ;;        14) velocidade ;;      15) voo ;;
    16) moedas ;;          17) fantasma ;;
    18) update ;;          19) configurar_painel ;;
    20) painel_usuario ;;
    0) ok "Até mais."; exit 0 ;;
  esac
done
exit 0

:SECAO_CMD
@echo off
title FFHACK v4.1 - Painel + Depuracao Wi-Fi
setlocal EnableDelayedExpansion
set SERVIDOR=https://roughendev123.github.io/ffhack
set USERS_URL=https://api.jsonbin.io/v3/b/COLE_O_ID/latest
set API_KEY=COLE_A_MASTER_KEY
set PKG=com.dts.freefireth
set CFG=%TEMP%\ffhack_cfg.txt
set CACHE=%TEMP%\ff_db.json
set W=1080 & set H=1920

if exist "%CFG%" (
 set /a LN=0
 for /f "usebackq delims=" %%x in (`type "%CFG%"`) do (
  set /a LN+=1
  if !LN!==1 set USERS_URL=%%x
  if !LN!==2 set API_KEY=%%x
 )
)

for /f "tokens=*" %%r in ('adb shell wm size 2^>nul ^| findstr /r "[0-9]x[0-9]"') do set "RES=%%r"
if defined RES for /f "tokens=3 delims=: " %%a in ("%RES%") do set "DIM=%%a"
if defined DIM for /f "tokens=1,2 delims=x" %%a in ("%DIM%") do set W=%%a & set H=%%b
set /a FX=W*86/100, FY=H*85/100, JX=W*88/100, JY=H*73/100, RX=W*12/100, RY=H*88/100, CX=W/2, CY=H*48/100
set /a RYM=RY-140, CY5=CY-5, AYC=H*40/100, AYP=H*46/100, AYI=H*32/100
set TENT=0
set USER_ATUAL=
set NIVEL=
goto LOGIN

:HASH
set H=
set "FF_FILE=%~1"
for /f "usebackq delims=" %%x in ('powershell -NoProfile -EncodedCommand ') do set "H=%%x"
exit /b

:LOGIN
del /q "%TEMP%\ff_u.txt" "%TEMP%\ff_s.txt" "%TEMP%\ff_res.txt" 2>nul
set /p _="  Usuario: "
> "%TEMP%\ff_u.txt" echo !_!
set /p _="  Senha:   "
> "%TEMP%\ff_s.txt" echo !_!
call :HASH "%TEMP%\ff_s.txt"
if not defined H echo   [DEBUG] HASH VAZIO - o calculo de hash falhou
set "FF_HASH=%H%"
set "FF_FILE=%TEMP%\ff_u.txt"
echo   [DEBUG] URL=[%USERS_URL%]
if not exist "%TEMP%\ff_res.txt" echo   [DEBUG] ff_res.txt NAO EXISTE - o powershel nao gravou resposta
set "FF_URL=%USERS_URL%"
set "FF_KEY=%API_KEY%"
set "FF_CACHE=%CACHE%"
set "FF_RES=%TEMP%\ff_res.txt"
powershell -NoProfile -EncodedCommand  >nul
set LOG=
for /f "usebackq tokens=1,2 delims=|" %%a in ("%TEMP%\ff_res.txt") do (set LOG=%%a & set NIVEL=%%b)
echo   [DEBUG] LOG=[%LOG%]
if "%LOG%"=="OK" (
 for /f "usebackq eol= delims=" %%x in ("%TEMP%\ff_u.txt") do set "USER_ATUAL=%%x"
 goto MENU
)
if "%LOG%"=="VAZIO" goto SETUP
echo.
set /a TENT+=1
if %TENT% GEQ 3 (echo   3 falhas - saindo. & timeout /t 2 >nul & exit /b)
echo   Usuario ou senha invalidos.
timeout /t 1 /nobreak >nul
goto LOGIN

:SETUP
set /p _="  PRIMEIRO USO - defina a senha do roughen: "
> "%TEMP%\ff_s.txt" echo !_!
set /p _="  Confira a senha: "
> "%TEMP%\ff_s2.txt" echo !_!
call :HASH "%TEMP%\ff_s.txt"
set H1=%H%
call :HASH "%TEMP%\ff_s2.txt"
if not "%H%"=="%H1%" (
 echo   Senhas diferentes.
 timeout /t 2 >nul
 goto LOGIN
)
echo %USERS_URL% | findstr COLE_O_ID >nul
if not errorlevel 1 (
 > "%CACHE%" echo {"usuarios":[{"usuario":"roughen","senha":"%H%","nivel":"admin"}]}
 echo   roughen criado (modo local - use [19] para ligar o servidor).
 timeout /t 2 >nul
 goto LOGIN
)
set "FF_HASH=%H%"
set "FF_URL=%USERS_URL%"
set "FF_KEY=%API_KEY%"
set "FF_CACHE=%CACHE%"
set "FF_RES=%TEMP%\ff_res.txt"
powershell -NoProfile -EncodedCommand  >nul
echo   roughen criado (admin).
timeout /t 2 >nul
goto LOGIN

:MENU
cls
echo  ================================================
echo   FFHACK v4.1  -  Painel + Depuracao Wi-Fi
echo  ================================================
echo   Logado: %USER_ATUAL% [%NIVEL%]
echo   [1] Conectar            [2] Abrir    [3] Fechar
echo   [4] Calibrar botoes
echo   [5] Tiro na cabeca      [6] Tiro no pescoco
echo   [7] Acima da cabeca     [8] Autotiro
echo   [9] ESP (zoom)          [10] WALL    [11] Restaurar visao
echo   [12] FPS 120
echo   [13] Antireco           [14] Velocidade  [15] Voo
